{
  "name": "oh-my-pi-vscode-sessions",
  "displayName": "Oh My Pi Sessions",
  "description": "Run concurrent structured Oh My Pi RPC sessions in native VS Code editor tabs, each bound to its own folder or Git worktree.",
  "version": "2.2.2",
  "publisher": "takeoff69",
  "icon": "oh-my-pi-vscode-logo.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TAKEOFF69/oh-my-pi-vscode-sessions"
  },
  "extensionKind": [
    "workspace"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "keywords": [
    "rpc",
    "omp",
    "oh-my-pi",
    "pty",
    "xterm",
    "tabs",
    "worktree",
    "sessions",
    "ai"
  ],
  "activationEvents": [
    "onView:ohMyPiSessions.sessions",
    "onCommand:ohMyPiSessions.open",
    "onCommand:ohMyPiSessions.newSession",
    "onCommand:ohMyPiSessions.newSessionInWorktree",
    "onCommand:ohMyPiSessions.newTerminalSession",
    "onCommand:ohMyPiSessions.newReadOnlySession",
    "onCommand:ohMyPiSessions.newLoopSession",
    "onCommand:ohMyPiSessions.showLogs",
    "onCommand:ohMyPiSessions.sendLines",
    "onCommand:ohMyPiSessions.sendSelection",
    "onCommand:ohMyPiSessions.sendFile",
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "oh-my-pi-sessions",
          "title": "OMP Sessions",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "oh-my-pi-sessions": [
        {
          "id": "ohMyPiSessions.sessions",
          "name": "Sessions",
          "icon": "media/activity-icon.svg",
          "contextualTitle": "Oh My Pi Sessions"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "ohMyPiSessions.sessions",
        "contents": "Start OMP and decide what to do in conversation.\n[New session](command:ohMyPiSessions.newSession)",
        "when": "!ohMyPiSessions.hasSessions"
      }
    ],
    "commands": [
      {
        "command": "ohMyPiSessions.open",
        "title": "Open Active Session",
        "category": "OMP Sessions",
        "icon": "$(terminal)"
      },
      {
        "command": "ohMyPiSessions.newSession",
        "title": "New Session",
        "category": "OMP Sessions",
        "icon": "$(add)"
      },
      {
        "command": "ohMyPiSessions.newSessionInWorktree",
        "title": "Advanced: New Session in Chosen Worktree…",
        "category": "OMP Sessions",
        "icon": "$(folder-opened)"
      },
      {
        "command": "ohMyPiSessions.newTerminalSession",
        "title": "Advanced: Open Diagnostic TUI",
        "category": "OMP Sessions",
        "icon": "$(terminal)"
      },
      {
        "command": "ohMyPiSessions.newReadOnlySession",
        "title": "Advanced: New Read-Only Session",
        "category": "OMP Sessions",
        "icon": "$(lightbulb)"
      },
      {
        "command": "ohMyPiSessions.newLoopSession",
        "title": "Advanced: New Loop Controller",
        "category": "OMP Sessions",
        "icon": "$(play-circle)"
      },
      {
        "command": "ohMyPiSessions.focusSession",
        "title": "Focus Session",
        "category": "OMP Sessions",
        "icon": "$(go-to-file)"
      },
      {
        "command": "ohMyPiSessions.restartSession",
        "title": "Restart Session",
        "category": "OMP Sessions",
        "icon": "$(debug-restart)"
      },
      {
        "command": "ohMyPiSessions.searchSession",
        "title": "Find in Session",
        "category": "OMP Sessions",
        "icon": "$(search)"
      },
      {
        "command": "ohMyPiSessions.renameSession",
        "title": "Rename Session",
        "category": "OMP Sessions",
        "icon": "$(edit)"
      },
      {
        "command": "ohMyPiSessions.closeSession",
        "title": "Close Session",
        "category": "OMP Sessions",
        "icon": "$(close)"
      },
      {
        "command": "ohMyPiSessions.closeAll",
        "title": "Close All Sessions",
        "category": "OMP Sessions",
        "icon": "$(close-all)"
      },
      {
        "command": "ohMyPiSessions.showLogs",
        "title": "Show Logs",
        "category": "OMP Sessions",
        "icon": "$(output)"
      },
      {
        "command": "ohMyPiSessions.sendLines",
        "title": "Send Line Reference to OMP",
        "category": "OMP Sessions",
        "icon": "$(code)"
      },
      {
        "command": "ohMyPiSessions.sendSelection",
        "title": "Send Selection to OMP",
        "category": "OMP Sessions",
        "icon": "$(terminal)"
      },
      {
        "command": "ohMyPiSessions.sendFile",
        "title": "Send File Path to OMP",
        "category": "OMP Sessions",
        "icon": "$(file)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ohMyPiSessions.newSession",
          "when": "view == ohMyPiSessions.sessions",
          "group": "navigation@1"
        },
        {
          "command": "ohMyPiSessions.closeAll",
          "when": "view == ohMyPiSessions.sessions && ohMyPiSessions.hasSessions",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "ohMyPiSessions.focusSession",
          "when": "view == ohMyPiSessions.sessions && viewItem == ohMyPiSession",
          "group": "inline@1"
        },
        {
          "command": "ohMyPiSessions.restartSession",
          "when": "view == ohMyPiSessions.sessions && viewItem == ohMyPiSession",
          "group": "inline@2"
        },
        {
          "command": "ohMyPiSessions.renameSession",
          "when": "view == ohMyPiSessions.sessions && viewItem == ohMyPiSession",
          "group": "session@1"
        },
        {
          "command": "ohMyPiSessions.closeSession",
          "when": "view == ohMyPiSessions.sessions && viewItem == ohMyPiSession",
          "group": "session@2"
        }
      ],
      "editor/context": [
        {
          "command": "ohMyPiSessions.sendLines",
          "when": "editorTextFocus",
          "group": "9_omp@1"
        },
        {
          "command": "ohMyPiSessions.sendSelection",
          "when": "editorTextFocus",
          "group": "9_omp@2"
        },
        {
          "command": "ohMyPiSessions.sendFile",
          "when": "resourceScheme == file",
          "group": "9_omp@3"
        }
      ]
    },
    "configuration": {
      "title": "Oh My Pi Sessions",
      "properties": {
        "ohMyPiSessions.executablePath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "OMP executable only; put arguments in `ohMyPiSessions.defaultArguments`. Windows auto-detects `%LOCALAPPDATA%\\omp\\omp.exe`; otherwise defaults to `omp`. Existing `ohMyPi.executablePath` is honored as a migration fallback."
        },
        "ohMyPiSessions.defaultArguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Arguments added to every OMP session, for example `--advisor` or `--thinking=max`."
        },
        "ohMyPiSessions.autoStart": {
          "type": "boolean",
          "default": false,
          "description": "Prompt for a session directory when VS Code starts."
        },
        "ohMyPiSessions.workingDirectory": {
          "type": "string",
          "default": "",
          "markdownDescription": "Fallback session directory when no workspace is open."
        }
      }
    },
    "keybindings": [
      {
        "command": "ohMyPiSessions.newSession",
        "key": "ctrl+shift+alt+i",
        "mac": "cmd+shift+alt+i"
      },
      {
        "command": "ohMyPiSessions.searchSession",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "activeWebviewPanelId == ohMyPiSessions.session"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "parity:selftest": "tsx scripts/rpc-parity-selftest.ts",
    "package": "vsce package",
    "package:all": "node scripts/package-all.mjs"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.1.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^5.5.0",
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/markdown-it": "^14.1.2",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
